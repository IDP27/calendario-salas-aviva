# Use um banco PostgreSQL dedicado. Não coloque credenciais reais no Git.
DATABASE_URL=postgresql://usuario:senha@127.0.0.1:5432/calendario
CALENDAR_PORT=4174
# Em HTTPS compartilhado, configure 1. No piloto local HTTP, mantenha 0.
CALENDAR_SECURE_COOKIES=0
# Configure 0 após criar o primeiro administrador, especialmente atrás de proxy.
CALENDAR_ALLOW_LOCAL_SETUP=1
# Defina CALENDAR_SECRET_KEY no ambiente da implantação ou proteja instance/secret-key.
